rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone can read products (for the website)
    // Only the admin email can create, edit or delete
    match /products/{id} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == "ADMIN_EMAIL_HERE@gmail.com";
    }
    // everything else is blocked
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
