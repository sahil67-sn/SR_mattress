rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products sab dekh sakte hain (website ke liye)
    // Likh/badal/hata sirf admin ka email kar sakta hai
    match /products/{id} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == "ADMIN_EMAIL_YAHAN_LIKHEIN@gmail.com";
    }
    // baaki sab band
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
